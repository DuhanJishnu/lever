diff --git a/tests/test_cart.py b/tests/test_cart.py
new file mode 100644
--- /dev/null
+++ b/tests/test_cart.py
@@ -0,0 +1,22 @@
+from cart import cart_total, discounted, line_total
+
+
+def test_line_total():
+    assert line_total(10, 3) == 30
+
+
+def test_cart_total():
+    assert cart_total([(10, 2), (5, 1)]) == 25
+
+
+def test_empty_cart():
+    assert cart_total([]) == 0
+
+
+def test_discount_boundary():
+    assert discounted(100) == 100
+    assert discounted(101) == 90.9
+
+
+def test_no_discount_small():
+    assert discounted(50) == 50
